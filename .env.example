# Supabase Postgres: copy the URI from your project's Connect > Session pooler.
# Replace [YOUR-PASSWORD] and percent-encode reserved characters in the password.
# Keep the complete connection string on the server, never in public/script.js.
DATABASE_URL=
# Optional: path to the database CA certificate downloaded from Supabase.
# TLS certificate and hostname verification are required for remote databases.
DATABASE_SSL_CA_FILE=

HOST=127.0.0.1
PORT=4176
APP_URL=http://127.0.0.1:4176

# SMTP settings from your email provider. Keep credentials on the server.
SMTP_HOST=
SMTP_PORT=587
# false for STARTTLS (usually 587); true for immediate TLS (usually 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="UniBasket Zambia <sender@your-domain.com>"

# ZynlePay sandbox. Production payment endpoints are not enabled.
PAYMENT_MODE=test
ZYNLEPAY_SANDBOX_API_URL=https://sandbox.zynlepay.com/zynlepay/jsonapi
ZYNLEPAY_SANDBOX_MERCHANT_CODE=
ZYNLEPAY_SANDBOX_API_ID=
ZYNLEPAY_SANDBOX_API_KEY=
